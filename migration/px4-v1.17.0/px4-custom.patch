diff --git a/Tools/setup/xtdrone2_agent.sh b/Tools/setup/xtdrone2_agent.sh
new file mode 100644
index 0000000000..e6cc82b0aa
--- /dev/null
+++ b/Tools/setup/xtdrone2_agent.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Install the XRCE Agent version compatible with PX4 v1.17's default v2 client.
+set -e
+source "$(dirname "${BASH_SOURCE[0]}")/xtdrone2_env.sh"
+agent_source="$HOME/Micro-XRCE-DDS-Agent-v2.4.3"
+agent_prefix="$HOME/.local/px4-xrce-agent-v2.4.3"
+if [[ ! -d "$agent_source/.git" ]]; then
+    git clone --branch v2.4.3 --depth 1 https://github.com/eProsima/Micro-XRCE-DDS-Agent.git "$agent_source"
+fi
+if [[ "$(git -C "$agent_source" rev-parse HEAD)" != 73622810d984349b80bbac0ef55fc0b694d62222 ]]; then
+    printf 'Agent source is not the expected v2.4.3 commit.\n' >&2
+    exit 1
+fi
+cmake -S "$agent_source" -B "$agent_source/build" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX="$agent_prefix" \
+    -DCMAKE_INSTALL_RPATH="$agent_prefix/lib;/opt/ros/jazzy/lib" \
+    -DUAGENT_SUPERBUILD=ON \
+    -DUAGENT_P2P_PROFILE=OFF \
+    -DUAGENT_USE_SYSTEM_FASTDDS=ON \
+    -DUAGENT_USE_SYSTEM_FASTCDR=ON \
+    -DUAGENT_USE_SYSTEM_LOGGER=OFF
+cmake --build "$agent_source/build" --parallel 1
+cmake --install "$agent_source/build"
+printf 'Agent installed: %s/bin/MicroXRCEAgent\n' "$agent_prefix"
diff --git a/Tools/setup/xtdrone2_env.sh b/Tools/setup/xtdrone2_env.sh
new file mode 100644
index 0000000000..4e3103e127
--- /dev/null
+++ b/Tools/setup/xtdrone2_env.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# Source this file from a terminal: source Tools/setup/xtdrone2_env.sh
+# Supports Ubuntu 24.04, ROS 2 Jazzy and the user's Python virtual environment.
+if [[ ! -f /opt/ros/jazzy/setup.bash ]]; then
+    printf 'ROS 2 Jazzy is not installed in /opt/ros/jazzy.\n' >&2
+    return 1 2>/dev/null || exit 1
+fi
+source /opt/ros/jazzy/setup.bash
+if [[ ! -f "$HOME/xtd2_pyenv/bin/activate" ]]; then
+    printf 'Missing Python virtual environment: %s/xtd2_pyenv\n' "$HOME" >&2
+    return 1 2>/dev/null || exit 1
+fi
+source "$HOME/xtd2_pyenv/bin/activate"
+# ROS Jazzy supplies Gazebo Harmonic through its vendor packages.
+if [[ -d /opt/ros/jazzy/opt/gz_tools_vendor/bin ]]; then
+    export PATH="/opt/ros/jazzy/opt/gz_tools_vendor/bin:$PATH"
+fi
+# Keep the supported XRCE Agent separate from any system or v3 installation.
+if [[ -d "$HOME/.local/px4-xrce-agent-v2.4.3/bin" ]]; then
+    export PATH="$HOME/.local/px4-xrce-agent-v2.4.3/bin:$PATH"
+fi
diff --git a/Tools/setup/xtdrone2_smoke_test.py b/Tools/setup/xtdrone2_smoke_test.py
new file mode 100644
index 0000000000..415a65100d
--- /dev/null
+++ b/Tools/setup/xtdrone2_smoke_test.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Validate PX4, Gazebo, XRCE Agent and the installed XTDrone2 ROS node.
+
+Run after sourcing Tools/setup/xtdrone2_env.sh and ~/ws_xtd2/install/setup.bash.
+This starts headless simulation and reads telemetry without arming the vehicle.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import time
+
+import rclpy
+from xtd2_communication.multirotor_communication import MultirotorCommunication
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--xtdrone2-world', help='Validate an installed XTDrone2 world and spawn launch file')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    records = root / 'migration/px4-v1.17.0'
+    records.mkdir(parents=True, exist_ok=True)
+    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as port:
+        port.bind(('0.0.0.0', 8888))
+    env = os.environ.copy()
+    env.update(HEADLESS='1', PX4_UXRCE_DDS_NS='x500_0')
+    prefix = 'xtdrone2-' + args.xtdrone2_world + '-' if args.xtdrone2_world else ''
+    commands = [('agent-runtime', ['MicroXRCEAgent', 'udp4', '-p', '8888'])]
+    if args.xtdrone2_world:
+        from ament_index_python.packages import get_package_share_directory
+        assets = Path(get_package_share_directory('xtd2_gz_sim'))
+        env['GZ_SIM_RESOURCE_PATH'] = str(assets / 'models')
+        commands.extend([
+            ('gazebo-runtime', ['gz', 'sim', '-s', '-r', str(assets / 'worlds' / (args.xtdrone2_world + '.sdf'))]),
+            ('launch-runtime', ['ros2', 'launch', 'xtd2_launch', 'xtd2_vehicle_spawn_launch.py',
+                                'world_name:=' + args.xtdrone2_world, 'model:=gz_x500',
+                                'id:=0', 'namespace:=x500_0']),
+        ])
+    else:
+        commands.append(('px4-gazebo-runtime', ['make', 'px4_sitl', 'gz_x500']))
+    processes = []
+    logs = []
+    node = None
+    result = {'passed': False, 'namespace': 'x500_0', 'received_samples': 0}
+    try:
+        for name, command in commands:
+            log = (records / (prefix + name + '.log')).open('w')
+            logs.append(log)
+            processes.append(subprocess.Popen(command, cwd=root, env=env,
+                                              stdin=subprocess.PIPE, stdout=log, stderr=subprocess.STDOUT,
+                                              start_new_session=True))
+        rclpy.init()
+        node = MultirotorCommunication('gz_x500', 0, debug=True)
+        deadline = time.monotonic() + 90
+        previous = None
+        while time.monotonic() < deadline:
+            rclpy.spin_once(node, timeout_sec=0.2)
+            position = node.cur_vehicle_local_position
+            if position is not None and position.timestamp != previous:
+                previous = position.timestamp
+                result['received_samples'] += 1
+                result['position'] = {'timestamp': int(position.timestamp),
+                                      'x': float(position.x), 'y': float(position.y),
+                                      'z': float(position.z),
+                                      'xy_valid': bool(position.xy_valid),
+                                      'z_valid': bool(position.z_valid)}
+                if result['received_samples'] >= 5 and position.xy_valid and position.z_valid:
+                    result['passed'] = True
+                    break
+            if processes[0].poll() is not None:
+                raise RuntimeError('XRCE Agent exited before telemetry was received')
+        result['topic'] = '/x500_0/fmu/out/vehicle_local_position_v1'
+        result['agent_returncode_before_cleanup'] = processes[0].poll()
+        result['simulation_returncode_before_cleanup'] = processes[-1].poll()
+        result['world'] = args.xtdrone2_world or 'PX4 default'
+    except Exception as error:
+        result['error'] = repr(error)
+    finally:
+        if node is not None:
+            node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
+        for process in reversed(processes):
+            try:
+                os.killpg(process.pid, signal.SIGINT)
+            except ProcessLookupError:
+                pass
+        for process in reversed(processes):
+            try:
+                process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                try:
+                    os.killpg(process.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                process.wait(timeout=5)
+        for process in processes:
+            if process.stdin is not None:
+                process.stdin.close()
+        for log in logs:
+            log.close()
+        (records / (prefix + 'runtime-validation.json')).write_text(json.dumps(result, indent=2) + '\n')
+        print(json.dumps(result, indent=2), flush=True)
+    return 0 if result['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
