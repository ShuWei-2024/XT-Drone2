<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="astra_motion">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="landmark_left">
      <static>true</static><pose>4 1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 2</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="landmark_right">
      <static>true</static><pose>4 -1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 2</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="landmark_center">
      <static>true</static><pose>6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 0.8 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.8 2</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>model://astra_x500_motion</uri><name>astra_x500_motion</name><pose>0 0 1.0 0 0 0</pose></include>
  </world>
</sdf>
