<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="astra_x500_sensors">
    <!-- Reuse the PX4 x500 body and motor systems without modifying PX4. -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Regular 16 x 720 Mid-360 equivalent. This is not a Livox timing model. -->
    <link name="mid360_link">
      <pose relative_to="base_link">0 0 0.18 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <!-- Stylized Mid-360 exterior, visual only. Keep the original sensor,
           mass and mount. All surfaces stay below the lowest scan ray:
           z < 0.04 - radius * tan(15 degrees), including box corners. -->
      <visual name="mid360_mount">
        <pose>0 0 -0.044 0 0 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.016</length></cylinder></geometry>
        <material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.10 0.11 0.13 1</diffuse></material>
      </visual>
      <visual name="mid360_housing">
        <pose>0 0 -0.008 0 0 0</pose>
        <geometry><box><size>0.065 0.065 0.056</size></box></geometry>
        <material><ambient>0.72 0.75 0.79 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse></material>
      </visual>
      <visual name="mid360_dark_cap">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.06 0.07 0.09 1</ambient><diffuse>0.06 0.07 0.09 1</diffuse></material>
      </visual>
      <visual name="mid360_front_badge">
        <pose>0.0328 0 -0.003 0 0 0</pose>
        <geometry><box><size>0.001 0.025 0.016</size></box></geometry>
        <material><ambient>0.85 0.15 0.08 1</ambient><diffuse>0.85 0.15 0.08 1</diffuse></material>
      </visual>
      <sensor name="mid360_equivalent" type="gpu_lidar">
        <pose>0 0 0.04 0 0 0</pose>
        <topic>/sensors/lidar</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical>
          </scan>
          <range><min>0.20</min><max>40.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
    <joint name="mid360_joint" type="fixed"><parent>base_link</parent><child>mid360_link</child></joint>
    <frame name="mid360_scan_frame" attached_to="mid360_link">
      <pose relative_to="mid360_link">0 0 0.04 0 0 0</pose>
    </frame>

    <link name="camera_link">
      <pose relative_to="base_link">0.16 0 0.06 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <link name="camera_color_optical_frame">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="d435i_color" type="camera">
        <!-- Gazebo cameras look along +X; cancel the ROS optical-link rotation. -->
        <pose>0 0 0 1.57079632679 -1.57079632679 0</pose>
        <topic>/sensors/camera/color/image_raw</topic>
        <always_on>true</always_on><update_rate>30</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
          <clip><near>0.10</near><far>100.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="camera_color_optical_joint" type="fixed"><parent>camera_link</parent><child>camera_color_optical_frame</child></joint>

    <link name="camera_depth_optical_frame">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="d435i_depth" type="depth_camera">
        <pose>0 0 0 1.57079632679 -1.57079632679 0</pose>
        <topic>/sensors/camera/depth/image_raw</topic>
        <always_on>true</always_on><update_rate>30</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.10</near><far>40.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="camera_depth_optical_joint" type="fixed"><parent>camera_link</parent><child>camera_depth_optical_frame</child></joint>

    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.12 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="astra_imu" type="imu">
        <topic>/sensors/imu/data</topic>
        <always_on>true</always_on><update_rate>100</update_rate><visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <!-- Sensor-only stage: hold the vehicle at its world pose. -->
    <static>true</static>
  </model>
</sdf>
